# زكي — local LLM configuration (copy to .env.local)

# Where the Ollama server listens (local sovereign runtime).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Which open-source Arabic model backs Zaki (تحليل + صياغة). Pull it first with `ollama pull <model>`.
#   almaghrabima/ALLaM-Thinking  → ALLaM-7B (SDAIA), Arabic-first, step-by-step reasoning (default, 4.3GB)
#   qwen3:8b                     → strong Arabic + native <think> reasoning, 128K context (~5GB)
#   iKhalid/ALLaM:7b             → base ALLaM instruct (no reasoning trace)
ZAKI_MODEL=almaghrabima/ALLaM-Thinking

# Optional dedicated model for code mode (برمجة). Defaults to ZAKI_MODEL if unset.
# A coder model is far better at code than the 7B Arabic model:
#   ollama pull qwen2.5-coder:7b   (then set the line below)
# ZAKI_CODE_MODEL=qwen2.5-coder:7b

# Vision model for analysing uploaded IMAGES (and scanned pages). Must be a VL model.
#   ollama pull qwen2.5vl:7b   → Qwen2.5-VL, strong Arabic + OCR/document understanding (~6GB)
# PDFs are handled by text extraction (unpdf) and do NOT need this model.
ZAKI_VISION_MODEL=qwen2.5vl:7b

# Companion (ودّي) mode model. ALLaM stays polite and won't banter/curse back even when asked.
# Point this at a more expressive model for the full human personality:
#   ollama pull qwen3:8b           (then set the line below)
# ZAKI_COMPANION_MODEL=qwen3:8b

# Public OpenAI-compatible API (/v1/*). If set, clients must send Authorization: Bearer <key>.
# Leave empty for open local access; set a strong key before publishing.
# ZAKI_API_KEY=sk-zaki-change-me

# ── Human auth (login page + sessions) ──
# Secret used to sign session cookies — set a long random value before publishing.
# ZAKI_AUTH_SECRET=change-me-to-a-long-random-string
# Users as "name:sha256hex,...". Generate a hash:  printf '%s' 'yourpass' | shasum -a 256
# Default (CHANGE IT): admin / zaki-admin-2026
# ZAKI_AUTH_USERS=admin:8625f61c3665e92f726e8a8315fef107d8865124b1a97a068dd3d74dc27106bc
